{
  "manifest_version": 3,
  "name": "Bookswift",
  "version": "1.0.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "bookswift@nikoware.local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "description": "Minimalist center-screen bookmark launcher with search.",
  "permissions": [
    "bookmarks",
    "activeTab"
  ],
  "commands": {
    "toggle-launcher": {
      "suggested_key": {
        "default": "Ctrl+Space",
        "mac": "Command+Space"
      },
      "description": "Toggle Bookswift"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}